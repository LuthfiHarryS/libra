# ── Materi akademik & dokumen Penulisan Ilmiah (tidak dipublikasikan) ──
docs/
dafpus/
.planning/
figma/
CLAUDE.md
*.docx
~$*

# ── Aset unggahan (bukan kode) ──
# 33 MB sampul buku hasil pindaian terbitan + cadangan lama + logo sekolah.
# Dapat dibangkitkan ulang lewat skrip di python/scripts/.
uploads/

# ── Backend PHP ──
# Memuat JWT_SECRET, CHATBOT_TRAIN_KEY, TINYPNG_API_KEY, dan kredensial basis
# data. Salin config.example.php menjadi config.local.php lalu isi sendiri.
api/config.local.php
# Dependensi Composer — pulihkan dengan `composer install`.
vendor/

# ── Tooling agen ──
.claude/

# ── Node / React ──
node_modules/
dist/
build/
*.local

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
python/**/models/
*.joblib

# ── Env & rahasia ──
.env
.env.*
!.env.example

# Dump basis data — memuat hash kata sandi akun nyata. Repo ini publik, dan hash
# bcrypt dapat dipecah offline tanpa batas percobaan.
libra_dump.sql
*.sql.gz

# Skrip demo memuat kata sandi plaintext akun siswa dan admin.
start-demo.bat

# ── Berkas operasional server ──
# deploy/ TIDAK lagi diabaikan sejak 2026-08-01. Sebelumnya dikecualikan karena
# memuat IP dan nama akun SSH mesin produksi; keduanya kini ditulis sebagai
# placeholder <IP_VPS> dan <USER_SSH>, dan seluruh kredensial di dalamnya hanya
# contoh (GANTI_*). Repositori ini publik, jadi jangan pernah menaruh nilai
# aslinya di sana.

# ── Materi sumber & keluaran sementara (besar / berhak cipta) ──
# Catatan: '#' hanya menjadi komentar bila berada di AWAL baris. Komentar yang
# ditulis di belakang pola akan ikut terbaca sebagai bagian dari pola itu.
# 115 MB pindaian sampul terbitan
asli/
foto cover/
# Keluaran sementara pemotongan OpenCV
python/scripts/crops/
python/scripts/crops2/
# Termasuk Buku Pedoman Penulisan Ilmiah
*.pdf

# ── Materi Penulisan Ilmiah ──
# Seluruh naskah, gambar, daftar pustaka, berkas sidang, dan presentasi kini
# berada di satu folder. Repositori ini publik: yang dipublikasikan adalah
# kodenya, bukan tulisannya.
#
# Termasuk akademik/dokum/ — foto kepala sekolah, petugas perpustakaan, dan
# siswa SMP yang mengisi SUS. Orang sungguhan yang dapat dikenali, sebagian di
# bawah umur, dan tidak boleh dipublikasikan tanpa persetujuan tertulis.
akademik/

# Penjaga lapis kedua, kalau-kalau naskah baru tercecer di luar akademik/.
*.tex
*.tex.BACKUP*
*.lyx
*.lyx~

# Keluaran uji, dibangkitkan ulang oleh python/scripts/uji_blackbox_chatbot.py.
results/

# ── Editor & OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Log ──
*.log
npm-debug.log*
