# Salin berkas ini menjadi .env di folder yang sama, lalu isi nilainya.
# .env sudah diabaikan git — jangan pernah menaruh kunci asli di berkas
# .example ini, karena berkas ini ikut terpublikasi.

# ── Chatbot: lapisan Gemini (cabang eksperimen-gemini) ──
# Kunci dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kosongkan untuk memakai bawaan (gemini-2.5-flash).
GEMINI_MODEL=

# klasifikasi | hibrida | gemini
#   klasifikasi : NB/SVM + katalog saja, Gemini tidak pernah dipanggil
#   hibrida     : Gemini hanya saat classifier menyerah
#   gemini      : Gemini menjawab lebih dulu
CHATBOT_MODE=klasifikasi

# ── Pencarian sampul buku ──
# Kunci Books API dari console.cloud.google.com. BUKAN kunci Gemini —
# kunci AI Studio ditolak Books API. Dipakai python/scripts/cari_sampul.py.
GOOGLE_BOOKS_API_KEY=

# ── Chatbot: endpoint /train ──
# Tanpa nilai ini, /train menolak semua request (fail-secure).
CHATBOT_TRAIN_KEY=

# ── Basis data ──
# Bawaan sudah cocok dengan XAMPP (root tanpa kata sandi).
LIBRA_DB_HOST=localhost
LIBRA_DB_USER=root
LIBRA_DB_PASS=
LIBRA_DB_NAME=libra_db
